{
  "name": "solfa-scanner",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Solfa Scanner — photograph tonic sol-fa notation, correct it, and play it back",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @solfa/web",
    "build": "npm run build --workspace @solfa/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace @solfa/web",
    "py:api": "uvicorn solfa_api.main:app --reload --app-dir apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0"
  }
}
